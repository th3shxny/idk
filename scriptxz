--==================================================
-- MAIN LOOP
--==================================================

local positionTimer = 0

RunService.RenderStepped:Connect(function(deltaTime)

	applyMovementSettings()

	-- UPDATE ESP POSITION/TEXT
	-- ESP objects themselves update through their own connections.

	-- AIM LOCK
	if AimLockEnabled then

		if not isValidTarget(CurrentTarget) then
			CurrentTarget = getClosestTarget()
		end

		if CurrentTarget then
			CurrentTarget = findBetterTarget()
		end

		if isValidTarget(CurrentTarget) then

			local camera = workspace.CurrentCamera
			local head = getHead(CurrentTarget)

			if camera and head then

				local cameraPosition = camera.CFrame.Position

				local desiredCFrame =
					CFrame.lookAt(
						cameraPosition,
						head.Position
					)

				local trackingAmount =
					math.clamp(
						Smoothness * 2.5,
						0.12,
						1
					)

				camera.CFrame =
					camera.CFrame:Lerp(
						desiredCFrame,
						trackingAmount
					)
			end
		end
	end

	-- UPDATE LOCKED LABEL
	if CurrentTarget and isValidTarget(CurrentTarget) then
		LockedLabel.Text = "Locked Onto: " .. CurrentTarget.Name
	else
		LockedLabel.Text = "Locked Onto: None"
	end

	-- CURRENT POSITION
	positionTimer += deltaTime

	if positionTimer >= 0.1 then

		positionTimer = 0

		local root = getRoot(LocalPlayer)

		if root then

			local pos = root.Position

			CurrentPositionLabel.Text =
				string.format(
					"Current: %.1f, %.1f, %.1f",
					pos.X,
					pos.Y,
					pos.Z
				)
		end
	end
end)

