--==================================================
-- AIM TARGETING
--==================================================

local function getClosestTarget()

	local camera = workspace.CurrentCamera

	if not camera then
		return nil
	end

	local mousePosition = UserInputService:GetMouseLocation()
	local viewportSize = camera.ViewportSize

	local fovRadius =
		math.min(viewportSize.X, viewportSize.Y)
		* (FOV / 180)

	local closestPlayer = nil
	local closestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer and isAlive(player) then

			local head = getHead(player)

			if head then

				local screenPosition, visible =
					camera:WorldToViewportPoint(head.Position)

				if visible and screenPosition.Z > 0 then

					local distance =
						(
							Vector2.new(
								screenPosition.X,
								screenPosition.Y
							) - mousePosition
						).Magnitude

					if distance <= fovRadius
						and distance < closestDistance then

						closestDistance = distance
						closestPlayer = player
					end
				end
			end
		end
	end

	return closestPlayer
end

local function isValidTarget(player)

	if not player then
		return false
	end

	if player == LocalPlayer then
		return false
	end

	return isAlive(player)
end

local function findBetterTarget()

	local candidate = getClosestTarget()

	if not candidate then
		return CurrentTarget
	end

	if not CurrentTarget or not isValidTarget(CurrentTarget) then
		return candidate
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return CurrentTarget
	end

	local mousePosition = UserInputService:GetMouseLocation()

	local currentHead = getHead(CurrentTarget)
	local candidateHead = getHead(candidate)

	if not currentHead or not candidateHead then
		return CurrentTarget
	end

	local currentScreen, currentVisible =
		camera:WorldToViewportPoint(currentHead.Position)

	local candidateScreen, candidateVisible =
		camera:WorldToViewportPoint(candidateHead.Position)

	if not currentVisible or not candidateVisible then
		return CurrentTarget
	end

	local currentDistance =
		(
			Vector2.new(
				currentScreen.X,
				currentScreen.Y
			) - mousePosition
		).Magnitude

	local candidateDistance =
		(
			Vector2.new(
				candidateScreen.X,
				candidateScreen.Y
			) - mousePosition
		).Magnitude

	if candidateDistance + 25 < currentDistance then
		return candidate
	end

	return CurrentTarget
end

