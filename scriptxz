--==================================================
-- SLIDERS
--==================================================

local function createSlider(parent, titleText, y, minValue, maxValue, initialValue, callback, decimals)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 20)
	label.Position = UDim2.new(0, 0, 0, y)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(220, 220, 220)
	label.TextSize = 13
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = parent

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 8)
	bar.Position = UDim2.new(0, 0, 0, y + 27)
	bar.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	bar.BorderSizePixel = 0
	bar.Parent = parent

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(1, 0)
	barCorner.Parent = bar

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(170, 170, 170)
	fill.BorderSizePixel = 0
	fill.Parent = bar

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local dragging = false
	local currentValue = initialValue

	local function updateFromMouse(mouseX)
		local percentage = math.clamp(
			(mouseX - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		currentValue = minValue + ((maxValue - minValue) * percentage)

		if decimals == 0 then
			currentValue = math.floor(currentValue + 0.5)
		else
			local multiplier = 10 ^ decimals
			currentValue = math.floor(currentValue * multiplier + 0.5) / multiplier
		end

		local normalized = (currentValue - minValue) / (maxValue - minValue)

		fill.Size = UDim2.new(normalized, 0, 1, 0)

		if decimals == 0 then
			label.Text = titleText .. ": " .. tostring(currentValue)
		else
			label.Text = titleText .. ": " .. string.format("%." .. decimals .. "f", currentValue)
		end

		callback(currentValue)
	end

	local function setInitial()
		local normalized = (initialValue - minValue) / (maxValue - minValue)
		fill.Size = UDim2.new(normalized, 0, 1, 0)

		if decimals == 0 then
			label.Text = titleText .. ": " .. tostring(initialValue)
		else
			label.Text = titleText .. ": " .. string.format("%." .. decimals .. "f", initialValue)
		end
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			updateFromMouse(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			updateFromMouse(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	setInitial()

	return {
		GetValue = function()
			return currentValue
		end
	}
end

